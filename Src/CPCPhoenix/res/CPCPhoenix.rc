/////////////////////////////////////////////////////////////////////////////
// Spanish (Castilian) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ESP)
#ifdef _WIN32
LANGUAGE LANG_SPANISH, SUBLANG_SPANISH
#pragma code_page(1252)
#endif //_WIN32

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINMENU MENU 
BEGIN
    POPUP "File"
    BEGIN
        POPUP "Drive A"
        BEGIN
            MENUITEM "Insert Disk...",              ID_DRIVEA_INSERTDISK
            MENUITEM "Eject Disk",                  ID_DRIVEA_EJECTDISK
        END
        POPUP "Drive B"
        BEGIN
            MENUITEM "Insert Disk...",              ID_DRIVEB_INSERTDISK
            MENUITEM "Eject Disk",                  ID_DRIVEB_EJECTDISK
        END
        MENUITEM SEPARATOR
        MENUITEM "Exit\tAlt+F4",                ID_FILE_EXIT
    END
    POPUP "Settings"
    BEGIN
        POPUP "CPC Model"
        BEGIN
            MENUITEM "CPC 464",                     ID_SETTINGS_CPCMODEL_CPC464
            MENUITEM "CPC 664",                     ID_SETTINGS_CPCMODEL_CPC664
            MENUITEM "CPC 6128",                    ID_SETTINGS_CPCMODEL_CPC6128
            MENUITEM "CPC 6128 + MAXAM",            ID_SETTINGS_CPCMODEL_CPC6128_MAXAM
        END
        POPUP "Monitor Type"
        BEGIN
            MENUITEM "Color",                       ID_SETTINGS_MONITORTYPE_COLOR
            MENUITEM "Green",                       ID_SETTINGS_MONITORTYPE_GREEN
        END
        MENUITEM "Draw Scan Lines\tF1",         ID_SETTINGS_DRAWSCANLINES
        POPUP "Emulation Speed"
        BEGIN
            MENUITEM "25%",                         ID_SETTINGS_EMULATIONSPEED_25
            MENUITEM "50%",                         ID_SETTINGS_EMULATIONSPEED_50
            MENUITEM "100%\tF3",                    ID_SETTINGS_EMULATIONSPEED_100
            MENUITEM "Unlimited\tF4",               ID_SETTINGS_EMULATIONSPEED_UNLIMITED
        END
        MENUITEM SEPARATOR
        MENUITEM "Reset\tShift+F5",             ID_SETTINGS_RESET
    END
END

#endif    // Spanish (Castilian) resources
/////////////////////////////////////////////////////////////////////////////


