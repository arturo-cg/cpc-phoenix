/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_APPWINDOW           ICON                    "CPCPhoenix.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_APPWINDOWACCELERATORS ACCELERATORS 
BEGIN
    VK_F1,          ID_SETTINGS_DRAWSCANLINES, VIRTKEY, NOINVERT
    VK_F5,          ID_SETTINGS_RESET,      VIRTKEY, SHIFT, NOINVERT
    VK_F3,          ID_SETTINGS_EMULATIONSPEED_100, VIRTKEY, NOINVERT
    VK_F4,          ID_SETTINGS_EMULATIONSPEED_UNLIMITED, VIRTKEY, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "TODO: <Company name>"
            VALUE "FileDescription", "TODO: <File description>"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "CPCPhoenix.exe"
            VALUE "LegalCopyright", "TODO: (c) <Company name>.  All rights reserved."
            VALUE "OriginalFilename", "CPCPhoenix.exe"
            VALUE "ProductName", "TODO: <Product name>"
            VALUE "ProductVersion", "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END


